# Copy this file to .env when you want local overrides.
# Do not commit real passwords.

# MES source code stays outside this Docker infrastructure folder.
# Update this path on a new PC if the source tree is elsewhere.
MES_CODE_ROOT=C:/Users/ertun/Documents/.CODE/codex/MES

# Portable runtime/data root. Keep runtime data outside the git repo.
MES_PORTABLE_RUNTIME_ROOT=C:/Users/ertun/Documents/.CODE/.DOCKER/MES

# PostgreSQL is only ready infrastructure in this phase.
# The current MES app does not use PostgreSQL as source-of-truth.
POSTGRES_DB=mes
POSTGRES_USER=mes
POSTGRES_PASSWORD=change_me_local_only

MES_WEB_DB_ENABLED=false
MES_WEB_DB_MIRROR_WORK_ORDERS=false
MES_WEB_DB_HOST=mes_postgres
MES_WEB_DB_PORT=5432
MES_WEB_DB_NAME=mes
MES_WEB_DB_USER=mes
MES_WEB_DB_PASSWORD=change_me_local_only

# SQL Source-of-Truth Transition Flags
MES_WEB_DB_FAIL_OPEN=false
MES_WEB_DB_LOG_FAILURES=false
MES_WEB_DB_HOOK_PRODUCTION_COMPLETIONS=false
MES_WEB_DB_HOOK_VISION_EVENTS=false
MES_WEB_DB_HOOK_OEE_SNAPSHOTS=false
MES_WEB_DB_HOOK_DOWNTIME_EVENTS=false
MES_WEB_DB_HOOK_MAINTENANCE_RECORDS=false
MES_WEB_DB_HOOK_QUALITY_OVERRIDES=false
MES_WEB_DB_HOOK_PRODUCTION_COMPLETIONS_DRY_RUN=false
MES_WEB_DB_HOOK_VISION_EVENTS_DRY_RUN=false
MES_WEB_DB_HOOK_OEE_SNAPSHOTS_DRY_RUN=false
MES_WEB_DB_SHADOW_READ_WORK_ORDERS=false
MES_WEB_DB_READ_WORK_ORDERS=false
MES_WEB_DB_SHADOW_READ_DASHBOARD=false
MES_WEB_DB_READ_DASHBOARD=false
MES_WEB_DB_STRICT_TIMESTAMP_GUARD=false

# Enables read-only station execution config API endpoints. Default: false.
MES_WEB_DB_STATION_EXECUTION_CONFIG_READ_MODEL_ENABLED=false

# Enables the controlled local work-order route-release API. Default: false.
MES_WEB_DB_WORK_ORDER_ROUTE_RELEASE_ENABLED=false

# Enables Canonical station execution context and commands. Default: false.
MES_WEB_DB_STATION_EXECUTION_COMMANDS_ENABLED=false
# Enables canonical MQTT station-source ingestion; core commands must also be enabled.
MES_WEB_MQTT_STATION_EXECUTION_ADAPTER_ENABLED=false
MES_WEB_MQTT_STATION_EXECUTION_CLIENT_ID=mes-web-station-execution
MES_WEB_MQTT_STATION_EXECUTION_ENQUEUE_TIMEOUT_SECONDS=5.0
# Enables Kiosk dynamic step actions; core commands must also be enabled.
MES_WEB_KIOSK_DYNAMIC_ACTIONS_ENABLED=false
