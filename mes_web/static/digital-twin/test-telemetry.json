{
  "name": "MES konveyör test telemetrisi",
  "description": "Kaynak çalışma kitaplarının hat/vardiya/üretim yapısı ve runtime alanlarına göre hazırlanmış sentetik senaryo dizisi. Gerçek kayıt değildir.",
  "sourceBasis": {
    "workbooks": [
      "MES_Konveyor_Veritabani_17-06-2026.xlsx",
      "MES_Konveyor_Veritabani_30-06-2026.xlsx"
    ],
    "runtimeState": "oee_runtime_state.json",
    "runtimeFields": [
      "speed",
      "running",
      "temperature",
      "count",
      "fillLevel"
    ],
    "line": "KNV-01",
    "stationExamples": [
      "SENS-01",
      "BUF-01",
      "ARM-01"
    ],
    "colors": [
      "red",
      "yellow",
      "blue"
    ],
    "note": "Excel olay, üretim tamamlama ve OEE şeması ile runtime canlı durum alanları referans alınmıştır; ölçümler sentetiktir."
  },
  "scenarios": [
    {
      "id": "normal_run",
      "from": 2,
      "to": 7,
      "expect": "Üretim ve hazne doluluğu artar, sıcaklık normal aralıkta."
    },
    {
      "id": "planned_pause",
      "from": 8,
      "to": 9,
      "expect": "Hat durur, üretim sayısı sabit kalır."
    },
    {
      "id": "recovery",
      "from": 10,
      "to": 13,
      "expect": "Hat yeniden çalışır, hız ve doluluk değişir."
    },
    {
      "id": "temperature_warning",
      "from": 14,
      "to": 17,
      "expect": "Sıcaklık 70 °C eşiğini aşar ve hat durur."
    },
    {
      "id": "restart",
      "from": 18,
      "to": 19,
      "expect": "Sıcaklık düşerken üretim devam eder."
    }
  ],
